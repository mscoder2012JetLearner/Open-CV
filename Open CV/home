import cv2
import numpy as np
image1=cv2.imread(r"C:\Users\maxsc\Open CV\images\junglea.jfif")
cv2.imshow("image1",image1)
cv2.waitKey(0)
image2=cv2.imread(r"C:\Users\maxsc\Open CV\images\jungleb.jfif")
cv2.imshow("image2",image2)
cv2.waitKey(0)
resizeimage1=cv2.resize(image1,(300,450))
cv2.imshow("resized",resizeimage1)
cv2.waitKey(0)
resizeimage2=cv2.resize(image2,(300,450))
cv2.imshow("resized2",resizeimage2)
cv2.waitKey(0)
addedimage1=cv2.addWeighted(resizeimage1,0.3,resizeimage2,0.7,0)
cv2.imshow("added1",addedimage1)
cv2.waitKey(0)
addedimage2=cv2.addWeighted(resizeimage1,0.7,resizeimage2,0.3,0)
cv2.imshow("added2",addedimage2)
