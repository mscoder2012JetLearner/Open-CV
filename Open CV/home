addedimage3=cv2.addWeighted(resizeimage1,0.5,resizeimage2,0.5,0)
cv2.imshow("added3",addedimage3)
cv2.waitKey(0)
subtractimage1=cv2.subtract(resizeimage1,resizeimage2)
cv2.imshow("subtract1",subtractimage1)
cv2.waitKey(0)
subtractimage2=cv2.subtract(resizeimage2,resizeimage1)
cv2.imshow("subtract2",subtractimage2)
cv2.waitKey(0)
kernal1=np.ones((3,3),np.uint8)
erorodedimage1=cv2.erode(resizeimage1,kernal1)
cv2.imshow("eroded",erorodedimage1)
cv2.waitKey(0)